{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["ES2020", "DOM"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "types": ["node"],
        "noEmitOnError": true
    },
    "include": [
        "src/**/*.ts",
        "api/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "publish",
        ".test-dist"
    ]
}
